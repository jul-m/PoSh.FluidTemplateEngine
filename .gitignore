## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results - all in out/ directory
out/

# Visual Studio 2015/2017 cache/options directory
.vs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
.nuget/
packages/

# Visual Studio Code
# .vscode/

# JetBrains Rider
.idea/
*.sln.iml

# macOS
.DS_Store

# PowerShell module artifacts
*.ps1xml
*.dll
*.pdb

# Local and temporary files
tmp/
*local
*.local.*
